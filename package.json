{
  "name": "griff",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"console.log('GRIFF static build')\"",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --schema public --level warning --fail-on error",
    "db:verify": "node scripts/run-database-contracts.mjs && node scripts/test-daily-volt-bonus-concurrency.mjs && node scripts/test-call-streak-concurrency.mjs && node scripts/test-growth-concurrency.mjs && node scripts/test-match-result-concurrency.mjs && npm run db:test:original-pack-concurrency && npm run economy:simulate",
    "db:test:daily-bonus-concurrency": "node scripts/test-daily-volt-bonus-concurrency.mjs",
    "db:test:streak-concurrency": "node scripts/test-call-streak-concurrency.mjs",
    "db:test:growth-concurrency": "node scripts/test-growth-concurrency.mjs",
    "db:test:concurrency": "node scripts/test-match-result-concurrency.mjs",
    "economy:simulate": "node scripts/simulate-volts-economy.mjs",
    "db:advisors": "supabase db advisors --local --type all --level warn --fail-on error",
    "pandascore:test": "node --test supabase/functions/clutch-pandascore-sync/pandascore.test.mjs",
    "mobile:architecture": "node --test scripts/mobile-import-boundaries.test.mjs && node scripts/check-mobile.mjs",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:lint": "npm --prefix mobile run lint -- --max-warnings=0",
    "mobile:test": "npm --prefix mobile run test:ci",
    "mobile:public-pages-test": "node scripts/test-public-release-pages.mjs && node --test scripts/test-growth-public-pages.mjs",
    "mobile:audit": "npm --prefix mobile audit --omit=dev --audit-level=high",
    "mobile:release-check": "node scripts/check-mobile-release.mjs",
    "db:test:original-pack-concurrency": "node scripts/test-fnatic-team-pack-concurrency.mjs sang-des-titans 1200 8 5"
  },
  "dependencies": {
    "@vercel/og": "0.11.1",
    "react": "19.2.8"
  }
}
