{
  "name": "clutch",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"console.log('Clutch static build')\"",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --schema public --level warning --fail-on error",
    "db:verify": "supabase db query --local --file supabase/tests/p0_mobile_contracts.sql",
    "db:advisors": "supabase db advisors --local --type all --level warn --fail-on error",
    "mobile:architecture": "node scripts/check-mobile.mjs",
    "mobile:typecheck": "npm --prefix mobile run typecheck"
  },
  "dependencies": {
    "@vercel/og": "0.11.1",
    "react": "19.2.8"
  }
}
