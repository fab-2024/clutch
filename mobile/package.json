    "expo": "~57.0.15",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
