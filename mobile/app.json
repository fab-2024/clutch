{
  "expo": {
    "name": "Clutch",
    "slug": "clutch-mobile",
    "version": "0.1.0",
    "description": "Le jeu social de prédiction e-sport, sans mise d’argent réel.",
    "orientation": "portrait",
    "scheme": "clutch",
    "icon": "./assets/app/icon.png",
    "backgroundColor": "#06080B",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fabthetap.clutch",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.fabthetap.clutch",
      "icon": "./assets/app/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/adaptive-icon.png",
        "backgroundColor": "#080B0F"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/app/notification-icon.png",
          "color": "#E8FF3D",
          "defaultChannel": "clutch-events"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/app/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#06080B",
          "dark": {
            "image": "./assets/app/splash-icon.png",
            "backgroundColor": "#06080B"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa56b1c1-eb15-4632-b247-e16dc4c562e2"
      }
    },
    "owner": "fabthetap"
  }
}
