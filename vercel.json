{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/api/app-association?platform=ios"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/api/app-association?platform=android"
    },
    {
      "source": "/privacy",
      "destination": "/api/legal-page?page=privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/legal-page?page=terms"
    },
    {
      "source": "/support",
      "destination": "/api/legal-page?page=support"
    },
    {
      "source": "/account-deletion",
      "destination": "/api/legal-page?page=deletion"
    },
    {
      "source": "/u/:pseudo",
      "destination": "/api/profile-page?pseudo=:pseudo"
    },
    {
      "source": "/i/:code",
      "destination": "/api/growth-page?kind=invite&id=:code"
    },
    {
      "source": "/v/:pseudo",
      "destination": "/api/growth-page?kind=showcase&id=:pseudo"
    },
    {
      "source": "/s/:pseudo/:milestone",
      "destination": "/api/growth-page?kind=milestone&id=:pseudo&milestone=:milestone"
    },
    {
      "source": "/l/:code",
      "destination": "/api/public-page?kind=league&id=:code"
    },
    {
      "source": "/c/:token",
      "destination": "/api/public-page?kind=challenge&id=:token"
    },
    {
      "source": "/m/:id",
      "destination": "/api/public-page?kind=match&id=:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    }
  ]
}
