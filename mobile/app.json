{
  "expo": {
    "name": "Clutch",
    "slug": "clutch-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "clutch",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
