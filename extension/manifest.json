{
  "manifest_version": 3,
  "name": "GRIFF — overlay esport",
  "version": "1.0.0",
  "description": "Affiche tes matchs GRIFF et pose tes calls sans quitter le stream Twitch ou YouTube.",
  "default_locale": "fr",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GRIFF",
    "default_icon": {
      "16": "icons/icone-16.png",
      "48": "icons/icone-48.png",
      "128": "icons/icone-128.png"
    }
  },
  "icons": {
    "16": "icons/icone-16.png",
    "48": "icons/icone-48.png",
    "128": "icons/icone-128.png"
  },
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    {
      "resources": ["icons/icone-128.png"],
      "matches": ["https://www.twitch.tv/*", "https://www.youtube.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*", "https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
