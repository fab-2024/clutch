{
  "expo": {
    "name": "GRIFF",
    "slug": "clutch-mobile",
    "version": "0.1.0",
    "description": "Le compagnon esport où chaque call laisse une marque, sans mise d’argent réel.",
    "orientation": "default",
    "scheme": ["griff", "clutch"],
    "icon": "./assets/app/griff-icon.png",
    "backgroundColor": "#06080B",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fabthetap.clutch",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.fabthetap.clutch",
      "icon": "./assets/app/griff-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/griff-adaptive-icon.png",
        "backgroundColor": "#05090C"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/app/griff-notification-icon.png",
          "color": "#E8FF3D",
          "defaultChannel": "clutch-events"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/app/griff-splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#06080B",
          "dark": {
            "image": "./assets/app/griff-splash-icon.png",
            "backgroundColor": "#06080B"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa56b1c1-eb15-4632-b247-e16dc4c562e2"
      }
    },
    "owner": "fabthetap"
  }
}
