{
  "expo": {
    "name": "Clutch",
    "slug": "clutch-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "clutch",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fabthetap.clutch",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.fabthetap.clutch"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa56b1c1-eb15-4632-b247-e16dc4c562e2"
      }
    },
    "owner": "fabthetap"
  }
}
