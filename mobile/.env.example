EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Clés SDK publiques RevenueCat, propres à chaque application store.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_YOUR_IOS_PUBLIC_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_YOUR_ANDROID_PUBLIC_KEY
# Facultatif en production web (ex. https://clutch.example.com)
# EXPO_PUBLIC_AUTH_REDIRECT_ORIGIN=
# Origine HTTPS publique utilisée pour les profils, invitations et pages légales.
# Elle doit pointer vers le domaine vérifié des Universal Links / App Links.
# EXPO_PUBLIC_APP_ORIGIN=https://clutch.example.com
# Informations obligatoires avant une soumission Store.
# EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
# EXPO_PUBLIC_LEGAL_ENTITY=Nom légal de l’éditeur
